# ==============================================================================
# Equinix + Arc + Fleet Manager demo (Microsoft Ignite 2026) - local configuration
#
# Copy to `.env` (gitignored) and fill in. This file holds CONFIGURATION ONLY.
# Never put secrets here:
#   - Equinix API credentials  -> shell env vars EQUINIX_API_CLIENTID /
#                                 EQUINIX_API_CLIENTSECRET (or EQUINIX_API_TOKEN)
#   - ExpressRoute service key -> handled in-process by the scripts, never stored
#   - Azure / AWS              -> official CLI logins (az login, aws sso login)
# See docs/AUTHENTICATION-AND-PERMISSIONS.md.
# ==============================================================================

# ---- Footprints ------------------------------------------------------------------
ENABLE_AZURE=true          # AKS member + Fleet hub (always needed for Fleet/Arc)
ENABLE_AWS=true            # EKS member (Arc over the public internet)
ENABLE_EQUINIX=true        # Kubernetes cluster in the Equinix cage (Arc member)
# true  = Equinix joins over ExpressRoute (circuit + Fabric + gateway + proxy)
# false = "rehearsal mode": the Equinix-labeled cluster joins over its own internet
ENABLE_EXPRESSROUTE=true

# ---- Naming / tagging --------------------------------------------------------------
NAME_PREFIX=eqarc
OWNER=
PROJECT=equinix-arc-demo
ENVIRONMENT=demo
EXPIRATION_DATE=2026-11-21

# ---- Azure ---------------------------------------------------------------------------
AZURE_EXPECTED_TENANT_ID=
AZURE_EXPECTED_SUBSCRIPTION_ID=
AZURE_REGION_OVERRIDE=     # blank = discover (westus2, westus3, eastus2)
AKS_NODE_VM_SIZE=Standard_D2s_v5
ARC_RESOURCE_GROUP=        # blank = the demo resource group; a separate group (created by scripts/06) lets 99-destroy-all -KeepArcGateway keep the gateway
ARC_REGION_OVERRIDE=

# ---- AWS -----------------------------------------------------------------------------
AWS_PROFILE=               # an SSO/named profile - never access keys here
AWS_ASSUME_ROLE_ARN=       # optional cross-account role: Terraform AND the EKS kubeconfig assume it
AWS_REGION_OVERRIDE=       # blank = discover (us-west-2, us-west-1, us-east-1)
AWS_EXPECTED_ACCOUNT_ID=

# ---- ExpressRoute (Azure side) ------------------------------------------------------
ER_PEERING_LOCATION=Silicon Valley    # Equinix SV1 - closest to Moscone (Ignite)
ER_BANDWIDTH_MBPS=50                   # Standard/MeteredData, ~$55/month + egress
ER_GATEWAY_SKU=ErGwScale               # 1 scale unit ~$0.21/hr; fallback ErGw1AZ
ER_PRIMARY_PEER_PREFIX=192.168.250.0/30
ER_SECONDARY_PEER_PREFIX=192.168.250.4/30
ER_VLAN_ID=200                         # private peering VLAN = Equinix C-tag

# ---- Equinix Fabric -----------------------------------------------------------------
EQUINIX_METRO_CODE=SV
EQUINIX_FABRIC_ORIGIN=port             # port | cloud_router | service_token
EQUINIX_REDUNDANT=true
EQUINIX_NOTIFICATION_EMAILS=           # comma-separated, required by Equinix
EQUINIX_PROJECT_ID=
EQUINIX_PURCHASE_ORDER=
# port origin (your cage ports + your edge router runs BGP to Microsoft)
EQUINIX_PRIMARY_PORT_UUID=
EQUINIX_SECONDARY_PORT_UUID=
EQUINIX_PORT_LINK_PROTOCOL=DOT1Q
EQUINIX_PRIMARY_VLAN_TAG=1010
EQUINIX_SECONDARY_VLAN_TAG=1020
EQUINIX_EDGE_ASN=65080
EDGE_PRIMARY_INTERFACE=GigabitEthernet1   # only used to render the IOS-XE snippet
EDGE_SECONDARY_INTERFACE=GigabitEthernet2
# cloud_router origin (Equinix Fabric Cloud Router runs BGP to Microsoft)
EQUINIX_CREATE_CLOUD_ROUTER=false
EQUINIX_CLOUD_ROUTER_UUID=
EQUINIX_ACCOUNT_NUMBER=
EQUINIX_FCR_CUSTOMER_PORT_UUID=        # FCR -> cage router leg (optional)
EQUINIX_FCR_CUSTOMER_VLAN_TAG=1030
EQUINIX_FCR_CUSTOMER_PEER_PREFIX=192.168.251.0/30
# service_token origin
EQUINIX_PRIMARY_SERVICE_TOKEN=
EQUINIX_SECONDARY_SERVICE_TOKEN=

# ---- Kubernetes cluster in the Equinix cage (BYO hardware; Equinix Metal is EOL) ---
EQUINIX_KUBE_CONTEXT=equinix-demo
EQUINIX_DISTRIBUTION=k3s               # az connectedk8s --distribution value
EQUINIX_ONPREM_PREFIXES=10.80.0.0/24   # cage subnet(s) advertised over ExpressRoute
EQUINIX_CLUSTER_SKIP_RANGES=10.42.0.0/16,10.43.0.0/16   # K3s pod/service CIDRs
# Extra egress-proxy allowlist entries (Squid dstdomain; leading dot = subdomains), comma-separated
PROXY_EXTRA_ALLOWED_DOMAINS=
# Publish the Equinix storefront through the Azure hub (nginx -> ExpressRoute):
EQUINIX_STOREFRONT_UPSTREAMS=          # e.g. 10.80.0.11:80,10.80.0.12:80 (K3s node IPs)
STOREFRONT_ALLOWED_CIDRS=              # presenter public IP(s), e.g. 203.0.113.10/32

# ---- Optional "Private Link" extras ---------------------------------------------------
ENABLE_PRIVATE_ACR=false               # Premium ACR + private endpoint, images over ER
ENABLE_DNS_PRIVATE_RESOLVER=false      # inbound endpoint for colo DNS forwarding
