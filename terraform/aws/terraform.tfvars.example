# Copy to terraform.tfvars (gitignored) - or let scripts/03-init-plan.ps1
# generate it from .env. No secrets belong in this file.

owner           = "your-alias"
project         = "equinix-arc-demo"
environment     = "demo"
expiration_date = "2026-11-21"

# region = "us-west-2"   # auto-selected by scripts/02-select-regions.ps1

# Named profile / SSO / assume-role auth - never a static access key:
# aws_profile         = "equinix-arc-demo"
# aws_assume_role_arn = "arn:aws:iam::123456789012:role/equinix-arc-demo-terraform"
# expected_account_id = "123456789012"

# vpc_cidr           = "10.60.0.0/16"
# cluster_version    = "1.35"
# node_instance_type = "t3.large"
# node_desired_size  = 2
# node_capacity_type = "ON_DEMAND"
